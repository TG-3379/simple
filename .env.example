# 키움증권 OpenAPI 인증 - 이 파일을 .env 로 복사한 뒤 본인 값으로 채우세요
APP_KEY=
APP_SECRET=

# demo: 모의투자 / real: 실전 (키 종류와 반드시 일치)
KIWOOM_MODE=demo

# 1 이면 주문 도구 활성화 (기본 0: 조회만)
KIWOOM_MCP_ALLOW_ORDERS=0

# 텔레그램 매매 알림 (trader/config.trading.jsonc 의 "알림.텔레그램" 이 true 일 때 사용)
# 토큰: 텔레그램에서 @BotFather 로 봇을 만들면 받는 값 / 채팅 id: 봇과 대화를 시작한 뒤 확인한 숫자
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
