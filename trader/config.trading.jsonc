{
  // ========== 공통: 모든 매매에 적용되는 한도와 시간 ==========
  "공통": {
    "모의투자": true, // true=모의투자 (실계좌 주문 : real 실계좌 주문은 코드에서 막아 둠)
    "거래소": "KRX", // 주문을 낼 거래소 (KRX / NXT)
    "거래시간": {
      "시작": "09:00",
      "종료": "15:20"
    }, // 이 시간 안에서만 감시/매매
    "최대종목수": 5, // 한 계좌에 보유할 수 있는 최대 종목 수 (필수, 이미 보유 중인 종목 포함). 이 수 이상으로는 새 종목을 절대 매수하지 않음
    "종목당주문금액": 500000, // 종목당 매수 금액(원) (null=1주씩)
    "하루손실한도": 100000, // 누적 실현손실이 이 금액(원)에 이르면 신규 매수 중단
    "하루매매횟수한도": 20, // 하루 최대 주문 횟수 (매수+매도)
    "감시주기초": 10 // 보유 종목 시세를 확인하는 간격(초)
  },
  // ========== 종목선택: 후보 종목을 모으는 방법과 그 값 ==========
  "종목선택": {
    "조건검색식": 40, // 값=조건식 번호 (HTS에 저장된 조건식)
    "관심종목": "000", // 값=관심종목 그룹코드 (0으로 시작해서 문자열)
    "실시간 조회 순위": 20 // 값=순위 상위 N개
  },
  // ---------- 종목선택 번호와 부가 설정 ----------
  "종목선택_상세": {
    "조건검색식": {
      "번호": 1,
      "설명": "값=조건식 번호(seq)"
    }, // 1번: 조건검색
    "관심종목": {
      "번호": 2,
      "설명": "값=관심종목 그룹코드(ka01300 으로 확인). 0으로 시작하므로 문자열"
    }, // 2번: 관심종목 그룹
    "실시간 조회 순위": {
      "번호": 3,
      "시장": "000",
      "설명": "값=상위 N개"
    } // 3번: 등락률 순위, 시장 000=전체 001=코스피 101=코스닥
  },
  // ========== 전략: 후보 중 매수할 종목을 걸러내는 조건 ==========
  "전략": {
    "시가 돌파": {
      "번호": 1,
      "시가대비_이상": 0.0
    }, // 1번: 현재가가 시가보다 N% 이상 높으면 통과 (0.0=시가 위)
    "M띠": {
      "번호": 2,
      "수식": null
    }, // 2번: 수식 미정이라 지금은 통과 종목 없음
    "5% 이상 상승": {
      "번호": 3,
      "등락률_이상": 5
    }, // 3번: 전일대비 등락률 +5% 이상이면 통과
    "5% 하락": {
      "번호": 4,
      "등락률_이하": -5
    } // 4번: 전일대비 등락률 -5% 이하이면 통과
  },
  // ========== 매수: 통과한 종목을 사는 방법 ==========
  "매수": {
    "일괄매수": {
      "번호": 1,
      "주문금액": 500000 // 일괄매수 때 종목당 한 번에 매수할 금액(원). 없으면 공통.종목당주문금액 사용
    }, // 1번: 주문금액만큼 한 번에 매수
    "분할매수": { // 2번: 나눠서 매수
      "번호": 2,
      "분할횟수": 5, // 균등 분할 횟수. 종목당주문금액을 이 횟수로 똑같이 나눠 매수 (5이면 1회차당 20%). 원하는 횟수로 조정
      "추가매수_하락률": 3.0 // 직전 매수가보다 이 비율(%) 이상 떨어지면 다음 회차 매수 (3.0=3%)
    }
  },
  // ========== 매도: 보유 종목을 파는 방법 (둘 다 켜도 됨) ==========
  "매도": {
    "스탑로스": {
      "번호": 1,
      "손절률": -3.0
    }, // 1번: 평균 매수가 대비 -3% 이하이면 전량 매도
    "분할매도": { // 2번: 오르면 나눠서 매도
      "번호": 2,
      "수익률간격": 0.5, // 평균 매수가 대비 수익률이 0.5% 오를 때마다(+0.5%, +1.0%, +1.5% ...) 한 번씩 매도. 단계 수는 전량매도_수익률 / 간격 으로 자동 결정
      "단계당_매도비율": 0.1, // 한 번에 파는 비율: 보유수량의 10%
      "매도기준": "현재보유량", // 10%를 무엇의 10%로 볼지: "현재보유량"(남은 수량의 10%, 팔수록 줄어듦) / "최대보유량"(처음 산 수량의 10%로 일정)
      "전량매도_수익률": 10.0 // 평균 매수가 대비 이 수익률(%) 이상이면 남은 수량 전부 일괄매도
    }
  },
  // ========== 실행: 이름 또는 번호로 기본 선택 (명령행 인자가 있으면 그쪽이 우선) ==========
  "실행": {
    "종목선택": "실시간 조회 순위", // 종목선택 방식 (이름 또는 종목선택_상세 번호)
    "전략": "5% 하락", // 사용할 전략 (이름 또는 번호)
    "매수": "분할매수", // 매수 방식 (이름 또는 번호)
    "매도": [
      "스탑로스",
      "분할매도"
    ] // 매도 방식 (여러 개 가능)
  }
}
// ======================================================================
//  매매법 설명 (프로그램이 위 설정을 어떻게 실행하는지)
// ======================================================================
//
//  [전체 흐름]  종목선택 -> 전략 필터 -> 매수 -> (반복) 감시 -> 매도
//
//  1. 종목선택 : "실행.종목선택" 방식으로 후보 종목을 모은다.
//       - 조건검색식(1)     : HTS에 저장된 조건식 번호의 검색 결과
//       - 관심종목(2)       : 관심종목 그룹코드에 담긴 종목
//       - 실시간 조회 순위(3): 전일대비 등락률 순위 상위 N개
//                             (전략 이름에 "하락"이 있으면 하락률 순위, 아니면 상승률 순위)
//
//  2. 전략 필터: 후보 중 "실행.전략" 조건을 통과한 종목만 남긴다. (매수 신호가 아니라 걸러내는 조건)
//       - 시가 돌파(1)  : 현재가가 시가보다 N% 이상 높음
//       - M띠(2)        : 수식 미정 -> 지금은 통과 종목 없음
//       - 5% 이상 상승(3): 전일대비 등락률 +5% 이상
//       - 5% 하락(4)    : 전일대비 등락률 -5% 이하
//
//  3. 매수 : 통과한 종목마다 "실행.매수" 방식으로 산다. (시장가)
//       - 일괄매수(1): 일괄매수.주문금액(없으면 공통.종목당주문금액)을 한 번에 매수
//       - 분할매수(2): 종목당주문금액을 분할횟수로 균등하게 나눠 매수
//                      1회차는 바로, 2회차부터는 직전 매수가보다 추가매수_하락률(%) 이상
//                      떨어질 때마다 한 회차씩 추가 매수 (마지막 회차까지)
//     매수 전 확인(하나라도 걸리면 매수하지 않음)
//       - 하루손실한도 / 하루매매횟수한도 도달
//       - 새 종목이면 계좌 보유 종목 수가 최대종목수 이상 (이미 보유 중인 종목은 새로 사지 않음)
//       - 계좌 보유 종목 조회에 실패하면 안전하게 매수 중단
//
//  4. 감시 : 감시주기초마다 보유 종목의 현재가를 확인하고 아래 순서로 처리한다.
//       (1) 분할매수 방식이면 추가 매수 조건 확인
//       (2) 스탑로스 : 평균 매수가 대비 손절률 이하이면 전량 매도하고 끝 (분할매도보다 우선)
//       (3) 분할매도 : 평균 매수가 대비 수익률로 판단
//             - 수익률이 전량매도_수익률 이상이면 남은 수량 전부 일괄매도
//             - 아니면 수익률이 수익률간격(%)만큼 오를 때마다(+0.5%, +1.0% ...) 보유수량의 단계당_매도비율 만큼 매도
//             - 10%를 무엇의 10%로 볼지는 매도기준: 현재보유량(남은 수량, 팔수록 줄어듦) / 최대보유량(처음 수량, 일정)
//             - 각 단계는 한 번씩만 실행 (수량은 내림, 최소 1주). 단계 수는 전량매도_수익률 / 수익률간격 으로 정해짐
//             - 가격이 한 번에 여러 단계를 넘으면 넘은 단계가 순서대로 모두 실행됨
//             - 남은 수량은 전량매도_수익률에 닿거나 스탑로스가 나올 때까지 보유
//     평균 매수가는 추가 매수 때마다 다시 계산된다.
//     (추가 매수로 평균가가 낮아지면 손절 기준선도 함께 내려간다)
//
//  5. 종료 : 보유 종목이 없어지거나, 거래시간이 끝나면 멈춘다.
//
//  [예시] 5% 하락 + 분할매수 + 스탑로스 + 분할매도 (종목당 50만 원)
//     전일대비 -6%인 종목 발견 -> 10만 원어치(1/5) 매수  (분할횟수 5 -> 회차당 균등 10만 원)
//     매수가보다 3% 더 하락할 때마다 10만 원어치씩 추가 매수 (추가매수_하락률 3.0, 최대 5회차까지)
//     평균가 대비 +0.5% 오를 때마다(+0.5%, +1.0% ... +9.5%) 현재 보유수량의 10%씩 매도 (100주면 90주 -> 81주 -> 73주 ...)
//     평균가 대비 +10% 이상 -> 남은 수량 전부 일괄매도
//     평균가 대비 -3% -> 언제든 전량 손절 매도
//     ※ 위 예시 숫자는 현재 설정값 기준. 설정을 바꾸면 이 설명도 같이 고칠 것
//
//  [주의]
//     - 기본은 주문을 보내지 않는 dry-run. 모의투자 서버로 실제 주문하려면 --live 로 실행
//     - 하루손실한도는 "실현" 손실만 센다 (아직 팔지 않은 평가손실은 포함되지 않음)
//     - 선택은 명령행으로 덮어쓸 수 있다:  py main.py --pick 3 --strategy 4 --buy 2 --sell 1 2  
// 
// 명